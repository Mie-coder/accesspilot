# 本地轻量 PostgreSQL；密码含特殊字符时必须先做 URL 百分号编码。
ACCESSPILOT_DATABASE_URL=postgresql+psycopg://accesspilot:replace-with-a-local-password@127.0.0.1:55432/accesspilot

# Compose 创建数据库时使用；请在本地 .env 中替换，不要提交真实密码。
POSTGRES_DB=accesspilot
POSTGRES_USER=accesspilot
POSTGRES_PASSWORD=replace-with-a-local-password
# Compose 内部主机名是 db；这里的编码后密码必须与上面的原始密码一致。
ACCESSPILOT_COMPOSE_DATABASE_URL=postgresql+psycopg://accesspilot:replace-with-a-local-password@db:5432/accesspilot
ACCESSPILOT_DB_PORT=55432
ACCESSPILOT_WEB_PORT=8080
# Compose入口的浏览器 Origin；生产 TLS 反代时覆盖为唯一 HTTPS Origin。
ACCESSPILOT_COMPOSE_WEB_ORIGIN=http://127.0.0.1:8080

# 浏览器 Origin 必须精确匹配；Vite 开发默认使用 127.0.0.1，不要混用 localhost。
ACCESSPILOT_WEB_ORIGIN=http://127.0.0.1:5173
ACCESSPILOT_AUTH_COOKIE_NAME=accesspilot_session
ACCESSPILOT_CSRF_COOKIE_NAME=accesspilot_csrf
# 本地 HTTP 必须为 false；只有生产 TLS 终止后才改为 true。
ACCESSPILOT_AUTH_COOKIE_SECURE=false
ACCESSPILOT_AUTH_SESSION_TTL_SECONDS=28800

# 作品集 Mock Login 固定 allowlist 为 EMP-001..004；这不是密码/注册/OIDC/真实 SSO。
ACCESSPILOT_DEMO_MODE_ENABLED=false

# DeepSeek 密钥只保存在后端环境；不要填写真实值后提交。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 百炼密钥同样只由后端读取；v4 请求会显式固定为 512 维。
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
